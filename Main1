составные условия и оператор switch
#include <stdio.h>

int main() {
    double value, result;
    int command;

    // Ввод значения
    printf("Введите значение: ");
    scanf("%lf", &value);

    // Вывод меню
    printf("\nВыберите команду:\n");
    printf("1 - метры в сантиметры\n");
    printf("2 - килограммы в граммы\n");
    printf("3 - градусы Цельсия в градусы Фаренгейта\n");
    printf("4 - часы в минуты\n");
    printf("Ваш выбор: ");
    scanf("%d", &command);

    // Проверка отрицательных значений для команд 1, 2 и 4
    if ((command == 1 || command == 2 || command == 4) && value < 0) {
        printf("Ошибка: значение не может быть отрицательным.\n");
        return 0;
    }

    // Выбор преобразования
    switch (command) {
        case 1:
            result = value * 100.0;
            printf("Результат: %.2f см\n", result);
            break;

        case 2:
            result = value * 1000.0;
            printf("Результат: %.2f г\n", result);
            break;

        case 3:
            result = value * 9.0 / 5.0 + 32.0;
            printf("Результат: %.2f °F\n", result);
            break;

        case 4:
            result = value * 60.0;
            printf("Результат: %.2f минут\n", result);
            break;

        default:
            printf("Ошибка: неизвестная команда.\n");
            break;
    }

    return 0;
}
